# RouteWise AI - Environment Configuration Example

FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
HOST=127.0.0.1

# Database Configuration (SQLite default; PostgreSQL connection string can be configured here)
DATABASE_URL=sqlite:///routewise.db
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/routewise_db

# Routing Service (OSRM-compatible endpoint)
OSRM_BASE_URL=https://router.project-osrm.org

# Geocoding Provider: nominatim | geoapify | locationiq
GEOCODING_PROVIDER=nominatim

# API Keys (leave empty for Nominatim / built-in Navi Mumbai presets)
GEOCODING_API_KEY=
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=

# Academic demonstration headers
USER_AGENT=RouteWiseAI-AcademicDemo/1.0 (academic-project)

# Routing Fallback Parameters
FALLBACK_SPEED_KMH=30.0
MAX_EXACT_STOPS=9
